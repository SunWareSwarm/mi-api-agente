# Copia este archivo a .env y completa tus claves. NUNCA subas el .env real.
REDIS_URL=redis://localhost:6379/0
GOOGLE_API_KEY=tu_api_key_de_google_ai_studio
TAVILY_API_KEY=tu_api_key_de_tavily

# Observabilidad (LangSmith): con estas 3 variables, las trazas se envían solas
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=tu_api_key_de_langsmith
LANGSMITH_PROJECT=mi-api-agente

# Opcional: segundos máximos por ejecución antes de marcar el job como FAILED
# JOB_TIMEOUT_SECONDS=300
